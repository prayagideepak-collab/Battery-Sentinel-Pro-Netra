<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_sparkline_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#101926"
    android:orientation="vertical"
    android:padding="12dp">

    <!-- Top Row: Title and Health Score -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/widget_sparkline_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="HEALTH DEGRADATION TREND"
            android:textColor="#00E5FF"
            android:textSize="10sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/widget_health_score"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Score: 98/100 (A)"
            android:textColor="#00E676"
            android:textSize="10sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- Subtitle metrics -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/widget_sparkline_level"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="85%"
            android:textColor="#FFFFFF"
            android:textSize="18sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/widget_sparkline_meta"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_weight="1"
            android:text="• Discharging • 32.1°C • 0 Thermal Alerts"
            android:textColor="#94A3B8"
            android:textSize="10sp" />
    </LinearLayout>

    <!-- Visual Sparkline Bitmap Canvas Image -->
    <ImageView
        android:id="@+id/widget_sparkline_image"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="6dp"
        android:layout_weight="1"
        android:scaleType="fitXY"
        android:contentDescription="Long-term battery health degradation sparkline" />

</LinearLayout>
